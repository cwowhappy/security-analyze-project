yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Backend
backend/.gradle/
backend/build/
