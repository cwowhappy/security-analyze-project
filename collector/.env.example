# ============================================
# 数据库配置
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db-security-analyze
DB_USER=user-security-analyze
DB_PASSWORD=SecurityAnalyze@2026

# 连接池（可选）
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ============================================
# Tushare 配置
# ============================================
TUSHARE_TOKEN=

# ============================================
# 采集策略
# ============================================
SOURCE_REQUEST_DELAY_MIN=1.0
SOURCE_REQUEST_DELAY_MAX=3.0

# 批次失败率阈值（超过此比例则任务标记为 failed）
BATCH_FAIL_THRESHOLD=0.1

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=text
