# 以下仅为示例值，须与后端 application.yml 中的数据库连接配置保持一致
DB_HOST=localhost
DB_PORT=5432
DB_NAME=security_analyze
DB_USER=stock
DB_PASSWORD=stock

# 连接池配置（可选）
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# 采集重试配置（可选）
# 注意：东方财富限流严重时，建议 retries=5, delay=3.0
SOURCE_MAX_RETRIES=5
SOURCE_RETRY_DELAY=3.0
SOURCE_RETRY_BACKOFF=2.0

# 请求间随机延迟（秒），用于缓解东方财富限流
SOURCE_REQUEST_DELAY_MIN=0.8
SOURCE_REQUEST_DELAY_MAX=2.0

# 财务采集配置（可选）
# 注意：东方财富对并发敏感，建议 max_workers=1, concurrent_workers=1
FINANCE_BATCH_SIZE=100
FINANCE_MAX_WORKERS=1
FINANCE_BATCH_CONCURRENT_WORKERS=1
