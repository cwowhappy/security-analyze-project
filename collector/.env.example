# ============================================
# 数据库配置
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db-security-analyze
DB_USER=user-security-analyze
DB_PASSWORD=SecurityAnalyze@2026

# 连接池（可选）
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ============================================
# Tushare 配置
# ============================================
TUSHARE_TOKEN=

# ============================================
# 采集策略
# ============================================
SOURCE_MAX_RETRIES=3
SOURCE_RETRY_DELAY=1.0
SOURCE_RETRY_BACKOFF=2.0
SOURCE_REQUEST_DELAY_MIN=1.0
SOURCE_REQUEST_DELAY_MAX=3.0

# 财务采集并发
FINANCE_BATCH_SIZE=100
FINANCE_MAX_WORKERS=1
FINANCE_BATCH_CONCURRENT_WORKERS=1

# ============================================
# APScheduler 配置
# ============================================
COLLECTOR_MAX_WORKERS=5
COLLECTOR_MISFIRE_GRACE_TIME=3600

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=text
